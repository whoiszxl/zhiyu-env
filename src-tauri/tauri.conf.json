{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智屿Env",
  "version": "0.1.0",
  "identifier": "dev.zhiyu.env",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "智屿",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "clipboard",
        "title": "剪贴板",
        "url": "/clipboard-panel.html",
        "width": 620,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "center": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
